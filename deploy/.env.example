BOT_TOKEN=123456:your-telegram-bot-token
TELEGRAM_ADMIN_ID=123456789
TELEGRAM_GROUP_CHAT_ID=-1001234567890
# api (по ключу) или agy (локальный CLI без лимитов ключа; в Docker-образе его нет)
GEMINI_BACKEND=api
# true — собрать образ с agy (нужно для GEMINI_BACKEND=agy), потом один раз войти, см. README
INSTALL_AGY=false
GEMINI_API_KEY=your-gemini-api-key
# Необязательно: если Google выведет модель из обращения, поменяй здесь без релиза кода
GEMINI_MODEL=gemini-3.5-flash
DB_PATH=/app/data/tobacconist.sqlite3
PORT=3000
PUBLIC_URL=https://tobacconist.example.com
PUBLIC_HOST=tobacconist.example.com
